# PMO-Legacy-API (old backend, port 7061). Copy to .env and fill in.

DATABASE_URL=

# The client app's address. Sign-in redirects go back here.
NEXT_PUBLIC_APP_URL="http://localhost:7060"
# This API's own address, for routes that call other routes of this API
NEXT_PUBLIC_API_BASE_URL="http://localhost:7061"

# App sign-in tokens. JWT_* must match the client's values.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Production only: share the auth cookie across subdomains
COOKIE_DOMAIN=

# IdP single sign-on (server side). "true" enables /api/auth/idp/*.
USE_IDP_AUTH="false"
NEXT_PUBLIC_IDP_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_AUTHORIZE_URL=
IDP_TOKEN_URL=
IDP_USERINFO_URL=
IDP_LOGOUT_URL=
IDP_SCOPE=
IDP_TOKEN_REQUEST_FORMAT=
IDP_WEBHOOK_SECRET=

# Document storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# Machine clients
FINANCE_API_ACCESS_KEY=
INVENTORY_API_URL=
INVENTORY_API_KEY=

# External services
NEXT_PUBLIC_HR_URL=
NEXT_PUBLIC_METABASE_URL=
METABASE_SECRET_KEY=
