// ===== PROJECT SCHEDULER MODELS =====

model ProjectSchedule {
  schedule_id          Int                    @id @default(autoincrement())
  name                 String
  description          String?
  user_id              Int                    // Creator
  project_id           Int?                   // Link to real project when approved
  portfolio_id         Int?                   // Link to portfolio
  eps_level_id         Int?                   // Link to EPS level
  status               ScheduleStatus         @default(draft)
  
  // Project Details
  start_date           DateTime
  planned_end_date     DateTime
  budget_amount        Float
  priority             ProjectPriority        @default(medium)
  type                 ProjectType
  location             String?
  client               String?
  contractor           String?
  strategic_value      ProjectStrategicValue  @default(medium)
  notes                String?
  
  // Analysis Results
  feasibility_score    Float?                 // 0-100
  conflicts_count      Int                    @default(0)
  resource_utilization Float?
  budget_variance      Float?
  risk_score           Float?
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  creator              User                   @relation("CreatedSchedules", fields: [user_id], references: [user_id])
  project              Project?               @relation("ProjectSchedules", fields: [project_id], references: [project_id])
  portfolio            Portfolio?             @relation("SchedulePortfolios", fields: [portfolio_id], references: [portfolio_id])
  eps                  EPS?                   @relation("ScheduleEPS", fields: [eps_level_id], references: [eps_id])
  approvals            ScheduleApproval[]
  
  // Comprehensive Planning Relations
  wbs_items            ScheduleWBS[]
  tasks                ScheduleTask[]
  // resources            Resource[]   // REMOVE or implement as a proper many-to-many if needed
  budgets              ScheduleBudget[]
  risks                ScheduleRisk[]
  team_members         ScheduleTeamMember[]
  procurements         ScheduleProcurement[]
  sites                ScheduleSite[]
  conflicts            ScheduleConflict[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([portfolio_id])
  @@index([eps_level_id])
}

model ScheduleWBS {
  wbs_id               Int                    @id @default(autoincrement())
  schedule_id          Int
  wbs_code             String
  name                 String
  description          String?
  parent_wbs_id        Int?
  level                Int
  start_date           DateTime
  end_date             DateTime
  // budget_amount: removed, now handled by ScheduleBudget
  progress_percentage  Float                  @default(0)
  status               WBSStatus              @default(not_started)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  parent               ScheduleWBS?           @relation("ParentChildWBS", fields: [parent_wbs_id], references: [wbs_id])
  children             ScheduleWBS[]          @relation("ParentChildWBS")
  tasks                ScheduleTask[]
  budget               ScheduleBudget?        @relation("WBSBudget")
  procurements         ScheduleProcurement[]
  @@index([schedule_id])
  @@index([parent_wbs_id])
}

model ScheduleTask {
  task_id              Int                    @id @default(autoincrement())
  schedule_id          Int
  wbs_id               Int?
  name                 String
  description          String?
  // Timing
  start_date           DateTime
  end_date             DateTime
  duration             Int                    // days
  early_start          DateTime?
  early_finish         DateTime?
  late_start           DateTime?
  late_finish          DateTime?
  total_float          Int?                   @default(0)
  free_float           Int?                   @default(0)
  // Progress & Status
  progress_percentage  Float                  @default(0)
  is_milestone         Boolean                @default(false)
  is_critical_path     Boolean                @default(false)
  priority             TaskPriority           @default(medium)
  status               TaskStatus             @default(todo)
  // Effort & Cost
  estimated_hours      Float                  @default(0)
  planned_hours        Float                  @default(0)
  work_package         String?
  // Dependencies
  dependencies         String[]               // Array of task IDs
  // Skills Required
  required_skills      Json                   // Skills needed for this task
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  wbs                  ScheduleWBS?           @relation(fields: [wbs_id], references: [wbs_id])
  assignments          ScheduleAssignment[]
  budget               ScheduleBudget?        @relation("TaskBudget")
  risks                ScheduleRisk[]
  predecessors         ScheduleTaskDependency[] @relation("Predecessor")
  successors           ScheduleTaskDependency[] @relation("Successor")
  risk_mitigations     ScheduleRiskMitigation[]
  user_assignments     ScheduleTaskAssignment[]
  @@index([schedule_id])
  @@index([wbs_id])
  @@index([start_date])
  @@index([end_date])
}

model ScheduleTaskAssignment {
  assignment_id Int @id @default(autoincrement())
  task_id       Int
  user_id       Int
  assigned_by   Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  task     ScheduleTask @relation(fields: [task_id], references: [task_id])
  user     User         @relation("UserAssignedTasks", fields: [user_id], references: [user_id])
  assigner User         @relation("AssignedBy", fields: [assigned_by], references: [user_id])
}

model ScheduleTaskDependency {
  dependency_id        Int                    @id @default(autoincrement())
  predecessor_task_id  Int
  successor_task_id    Int
  dependency_type      DependencyType
  lag_time             Int                    @default(0)
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  predecessor          ScheduleTask           @relation("Predecessor", fields: [predecessor_task_id], references: [task_id])
  successor            ScheduleTask           @relation("Successor", fields: [successor_task_id], references: [task_id])

  @@index([predecessor_task_id])
  @@index([successor_task_id])
}


model ScheduleAssignment {
  assignment_id        Int         @id @default(autoincrement())
  task_id              Int
  resource_id          Int
  allocation_percentage Float
  start_date           DateTime
  end_date             DateTime
  planned_hours        Float
  progress             Int         @default(0)
  
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  
  // Relations
  task                 ScheduleTask @relation(fields: [task_id], references: [task_id])
  resource             Resource     @relation(fields: [resource_id], references: [resource_id])

  @@index([task_id])
  @@index([resource_id])
  @@index([start_date])
  @@index([end_date])
}

model ScheduleTeamMember {
  team_member_id       Int                    @id @default(autoincrement())
  schedule_id          Int
  user_id              Int                    // Must link to existing user
  role                 String
  department           String
  is_lead              Boolean                @default(false)
  workload             Float                  @default(100)
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  user                 User                   @relation("UserSchedules", fields: [user_id], references: [user_id])

  @@unique([schedule_id, user_id])
  @@index([schedule_id])
  @@index([user_id])
}

model ScheduleBudget {
  budget_id            Int                    @id @default(autoincrement())
  schedule_id          Int
  wbs_id               Int?                   @unique
  task_id              Int?                   @unique
  cost_type            String                 // labor, material, equipment, overhead, etc.
  planned_amount       Float
  actual_amount        Float                  @default(0)
  variance             Float                  @default(0)
  threshold            Float                  @default(0)
  fiscal_year          Int
  fiscal_period        String
  description          String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  wbs                  ScheduleWBS?           @relation("WBSBudget", fields: [wbs_id], references: [wbs_id])
  task                 ScheduleTask?          @relation("TaskBudget", fields: [task_id], references: [task_id])
  @@index([schedule_id])
  @@index([wbs_id])
  @@index([task_id])
  @@index([cost_type])
}

model ScheduleRisk {
  risk_id              Int                    @id @default(autoincrement())
  schedule_id          Int
  task_id              Int?
  owner_id             Int?                   // Link to user
  name                 String
  description          String?
  category             RiskCategory           @default(other)
  impact               ImpactLevel
  probability          ProbabilityLevel
  risk_level           RiskLevel              @default(medium)
  risk_score           Int
  likelihood_score     Float?
  impact_score         Float?
  status               RiskStatus             @default(identified)
  identified_date      DateTime
  mitigation_plan      String?
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  task                 ScheduleTask?          @relation(fields: [task_id], references: [task_id])
  owner                User?                  @relation("RiskOwnerSchedules", fields: [owner_id], references: [user_id])
  mitigations          ScheduleRiskMitigation[]

  @@index([schedule_id])
  @@index([task_id])
  @@index([owner_id])
  @@index([status])
  @@index([category])
}

model ScheduleRiskMitigation {
  mitigation_id        Int                    @id @default(autoincrement())
  risk_id              Int
  task_id              Int?
  user_id              Int?                   // Assigned to
  description          String
  action_plan          String
  mitigation_type      MitigationType         @default(mitigate)
  start_date           DateTime
  due_date             DateTime
  status               MitigationStatus       @default(planned)
  progress_percentage  Float                  @default(0)
  notes                String?
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  risk                 ScheduleRisk           @relation(fields: [risk_id], references: [risk_id])
  task                 ScheduleTask?          @relation(fields: [task_id], references: [task_id])
  assignee             User?                  @relation("MitigationAssigneeSchedules", fields: [user_id], references: [user_id])

  @@index([risk_id])
  @@index([task_id])
  @@index([user_id])
  @@index([status])
  @@index([due_date])
}

model ScheduleProcurement {
  procurement_id       Int                    @id @default(autoincrement())
  schedule_id          Int
  wbs_id               Int?
  type                 ProcurementType
  description          String
  estimated_cost       Float
  actual_cost          Float                  @default(0)
  status               String                 @default("planned")
  vendor_name          String?
  delivery_date        DateTime?

  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])
  wbs                  ScheduleWBS?           @relation(fields: [wbs_id], references: [wbs_id])

  @@index([schedule_id])
  @@index([wbs_id])
  @@index([status])
}

model ScheduleSite {
  site_id              Int                    @id @default(autoincrement())
  schedule_id          Int
  name                 String
  address              String?
  coordinates          String?                // lat,lng
  site_type            String?                // office, construction, remote, etc.
  capacity             Int?
  description          String?
  
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])

  @@index([schedule_id])
}

model ScheduleConflict {
  conflict_id          Int                    @id @default(autoincrement())
  schedule_id          Int
  conflict_type        ConflictType
  severity             ConflictSeverity
  description          String
  affected_tasks       String[]               // Array of task IDs
  affected_resources   String[]               // Array of resource IDs
  suggested_resolution String?
  resolved             Boolean                @default(false)
  
  created_at           DateTime               @default(now())
  
  // Relations
  schedule             ProjectSchedule        @relation(fields: [schedule_id], references: [schedule_id])

  @@index([schedule_id])
  @@index([resolved])
}

model ScheduleApproval {
  id         Int            @id @default(autoincrement())
  schedule_id Int
  user_id    Int
  status     ApprovalStatus @default(PENDING)
  schedule   ProjectSchedule @relation(fields: [schedule_id], references: [schedule_id])
  user       User           @relation(fields: [user_id], references: [user_id])
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@index([schedule_id])
  @@index([user_id])
}

// ===== PROJECT SCHEDULER ENUMS =====

enum ScheduleStatus {
  draft
  analyzing
  feasible
  infeasible
  pending_approval
  approved
  rejected
  converted
}

enum ConflictType {
  resource_overallocation
  skill_mismatch
  dependency_violation
  timeline_conflict
  budget_exceeded
  resource_unavailable
  team_conflict
}

enum ConflictSeverity {
  low
  medium
  high
  critical
}

model RecentActivity {
  activity_id   Int                @id @default(autoincrement())
  user_id       Int
  action        String             // 'create', 'update', 'delete', 'assign', etc.
  entity_type   String             // 'project', 'task', 'risk', 'rfq', etc.
  entity_id     Int?               // ID of the entity that was acted upon
  title         String             // Human readable title
  description   String?            // Additional details
  metadata      Json?              // Additional data (entity names, old/new values, etc.)
  created_at    DateTime           @default(now())
  
  // Relations
  user          User               @relation(fields: [user_id], references: [user_id])

  @@index([user_id, created_at])
  @@index([entity_type, entity_id])
  @@index([created_at])
}
