generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  project_id          Int                   @id @default(autoincrement())
  project_code        String                @unique
  name                String
  description         String?
  start_date          DateTime
  planned_end_date    DateTime?
  must_finish_by_date DateTime?
  actual_end_date     DateTime?
  status                ProjectStatus         @default(planning)
  budget_amount         Float
  pending_budget_amount Float?
  actual_cost           Float
  allocated_cost        Float                 @default(0)
  progress_percentage Float                 @default(0)
  eps_level_id        Int
  portfolio_id        Int
  created_by          Int
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  required_approvals  Int                   @default(2)
  priority            ProjectPriority       @default(medium)
  compliance          projectCompliance     @default(pending)
  roi                 Float?                @default(0)
  expected_roi        Float?                @default(0)
  location            String?
  healthScore         Float                 @default(50)
  riskScore           Float                 @default(0)
  qualityScore        Float                 @default(50)
  client              String?
  contractor          String?
  tags                String[]
  strategicValue      ProjectStrategicValue @default(medium)
  type                ProjectType
  size                Float?
  archived            Boolean               @default(false)
  manager_id          Int
  Alert               Alert[]
  baselines           Baseline[]
  budgets             Budget[]
  documents           Document[]
  evms                EVM[]
  lessons             Lesson[]
  procurements        Procurement[]
  creator             User                  @relation("CreatedProjects", fields: [created_by], references: [user_id])
  eps                 EPS                   @relation(fields: [eps_level_id], references: [eps_id])
  manager             User                  @relation("ProjectManager", fields: [manager_id], references: [user_id])
  portfolio           Portfolio             @relation(fields: [portfolio_id], references: [portfolio_id])
  projectApprovals    ProjectApproval[]     @relation("Project_ProjectApprovals")
  assignments         ProjectAssignment[]
  checklists          ProjectChecklist[]
  setup               ProjectSetup?
  team_members        ProjectTeamMember[]
  risks               Risk[]
  sites               Site[]
  time_entries        TimeEntry[]
  timesheets          Timesheet[]
  Transaction         Transaction[]
  wbs                 WBS[]
  closure_documents   ClosureDocumentItem[]
  closure_checklists  ClosureChecklistItem[]
  punch_list_items    PunchListItem[]
  final_inspection    FinalInspection?
  handover            Handover?
  closure_approved_at DateTime?
  closure_approved_by Int?
  closure_notes       String?
  closure_approved_user User?    @relation("ClosureApprovedProjects", fields: [closure_approved_by], references: [user_id])
  
  // Project Scheduler Relations
  schedules            ProjectSchedule[]      @relation("ProjectSchedules")
}

model EPS {
  eps_id        Int       @id @default(autoincrement())
  eps_code      String    @unique @default(dbgenerated("('EPS-'::text || lpad((nextval('\"EPS_eps_id_seq\"'::regclass))::text, 3, '0'::text))"))
  name          String
  description   String?
  level         Int
  parent_eps_id Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  parent        EPS?      @relation("EPSHierarchy", fields: [parent_eps_id], references: [eps_id])
  children      EPS[]     @relation("EPSHierarchy")
  projects      Project[]
  schedules     ProjectSchedule[] @relation("ScheduleEPS")
}

model Portfolio {
  portfolio_id        Int               @id @default(autoincrement())
  name                String            @unique
  description         String?
  manager_id          Int
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  strategic_objective String?
  status              PortfolioStatus   @default(active)
  priority            PortfolioPriority @default(medium)
  tags                String[]
  budget_capacity     Float?            @default(0)
  manager             Account           @relation(fields: [manager_id], references: [account_id])
  projects            Project[]
  schedules           ProjectSchedule[] @relation("SchedulePortfolios")
}

model WBS {
  wbs_id              Int             @id @default(autoincrement())
  wbs_code            String
  name                String
  description         String?
  status              WBSStatus       @default(not_started)
  project_id          Int
  parent_wbs_id       Int?
  level               Int
  progress_percentage Float
  progress_weight     Float?            // Optional weight (0-100) for rolling up to project progress
  start_date          DateTime?
  end_date            DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  budgets             Budget[]
  documents           Document[]
  procurements        Procurement[]
  recurring_tasks     RecurringTask[]
  tasks               Task[]
  parent              WBS?            @relation("ParentChildWBS", fields: [parent_wbs_id], references: [wbs_id])
  children            WBS[]           @relation("ParentChildWBS")
  project             Project         @relation(fields: [project_id], references: [project_id])
  wbsItems            WBSItem[]
}

model WBSItem {
  wbs_item_id         Int      @id @default(autoincrement())
  wbs_item_code       String
  name                String
  description         String?
  start_date          DateTime?
  end_date            DateTime?
  budget_amount       Float
  actual_cost         Float
  progress_percentage Float
  wbs_id              Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  wbs                 WBS      @relation(fields: [wbs_id], references: [wbs_id])
}

model Task {
  task_id                  Int                  @id @default(autoincrement())
  name                     String
  description              String?
  wbs_id                   Int
  start_date               DateTime
  end_date                 DateTime
  actual_start_date        DateTime?
  actual_end_date          DateTime?
  duration                 Int
  progress_percentage      Float
  is_milestone             Boolean              @default(false)
  is_critical_path         Boolean              @default(false)
  priority                 TaskPriority         @default(medium)
  status                   TaskStatus           @default(todo)
  early_start              DateTime?
  early_finish             DateTime?
  late_start               DateTime?
  late_finish              DateTime?
  total_float              Int?                 @default(0)
  free_float               Int?                 @default(0)
  created_by               Int
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  estimated_hours          Float                @default(0)
  actual_hours             Float                @default(0)
  work_package             String?
  budgets                  Budget[]
  documents                Document[]
  Escalation               Escalation[]
  FieldData                FieldData[]
  PerformanceMetric        PerformanceMetric[]
  resourceAssignments      ResourceAssignment[]
  risk_mitigations         RiskMitigation[]
  Scorecard                Scorecard[]
  creator                  User                 @relation("CreatedTasks", fields: [created_by], references: [user_id])
  wbs                      WBS                  @relation(fields: [wbs_id], references: [wbs_id])
  assigned_users           TaskAssignment[]
  comments                 TaskComment[]
  predecessor_dependencies TaskDependency[]     @relation("Predecessor")
  successor_dependencies   TaskDependency[]     @relation("Successor")
  time_entries             TimeEntry[]
  action_rules             WorkflowRule[]       @relation("ActionTask")
  trigger_rules            WorkflowRule[]       @relation("TriggerTask")
}

model TaskDependency {
  dependency_id       Int            @id @default(autoincrement())
  predecessor_task_id Int
  successor_task_id   Int
  dependency_type     DependencyType
  lag_time            Int
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  predecessor         Task           @relation("Predecessor", fields: [predecessor_task_id], references: [task_id])
  successor           Task           @relation("Successor", fields: [successor_task_id], references: [task_id])
}

model Resource {
  resource_id         Int                        @id @default(autoincrement())
  name                String
  type                ResourceType
  role                String
  skills              Json
  rating              Int @default(0)
  rate                Float
  capacity            Int
  availability_status ResourceAvailabilityStatus
  department          String
  phone_number        String?
  email               String?
  location            String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  equipment_logs      EquipmentSiteLog[]
  MaintenanceLog      MaintenanceLog[]
  MaintenanceSchedule MaintenanceSchedule[]
  assignments         ResourceAssignment[]

  // Optional fields for material resources
  unit                String?                    // e.g. 'kg', 'ltr'
  quantity            Float?                     // initial stock quantity

  scheduleAssignments ScheduleAssignment[]

}

model ResourceAssignment {
  assignment_id         Int         @id @default(autoincrement())
  resource_id           Int
  task_id               Int
  allocation_percentage Float
  start_date            DateTime
  end_date              DateTime
  progress              Int         @default(0)
  planned_hours         Float
  actual_hours          Float
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  field_data            FieldData[]
  resource              Resource    @relation(fields: [resource_id], references: [resource_id])
  task                  Task        @relation(fields: [task_id], references: [task_id])
}

model Budget {
  budget_id      Int      @id @default(autoincrement())
  project_id     Int
  wbs_id         Int?
  task_id        Int?
  cost_type      String
  planned_amount Float
  actual_amount  Float
  variance       Float
  threshold      Float    @default(0)
  fiscal_year    Int
  fiscal_period  String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  project        Project  @relation(fields: [project_id], references: [project_id])
  task           Task?    @relation(fields: [task_id], references: [task_id])
  wbs            WBS?     @relation(fields: [wbs_id], references: [wbs_id])
}

model Risk {
  risk_id          Int              @id @default(autoincrement())
  project_id       Int
  owner_id         Int
  name             String
  description      String?
  category         RiskCategory     @default(other)
  impact           ImpactLevel
  probability      ProbabilityLevel
  riskLevel        RiskLevel        @default(medium)
  riskScore        Int
  likelihood_score Float?
  impact_score     Float?
  status           RiskStatus       @default(identified)
  approvalStatus   String
  currentStatus    String
  identified_date  DateTime
  last_reviewed    DateTime?
  next_review      DateTime?
  review_frequency Int?
  mitigationPlanId Int?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  owner            User             @relation("RiskOwner", fields: [owner_id], references: [user_id])
  project          Project          @relation(fields: [project_id], references: [project_id])
  mitigations      RiskMitigation[]

  @@index([project_id])
  @@index([status])
  @@index([category])
  @@index([owner_id])
  @@index([created_at])
  @@index([next_review])
}

model RiskMitigation {
  mitigation_id       Int              @id @default(autoincrement())
  risk_id             Int
  task_id             Int
  user_id             Int
  description         String
  action_plan         String
  mitigation_type     MitigationType   @default(mitigate)
  start_date          DateTime
  assigned_to         Int
  due_date            DateTime
  status              MitigationStatus @default(planned)
  progress_percentage Float            @default(0)
  completion_date     DateTime?
  notes               String?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  assignee            User             @relation("MitigationAssignee", fields: [assigned_to], references: [user_id])
  risk                Risk             @relation(fields: [risk_id], references: [risk_id])
  task                Task             @relation(fields: [task_id], references: [task_id])
  owner               User             @relation("MitigationOwner", fields: [user_id], references: [user_id])

  @@index([risk_id])
  @@index([task_id])
  @@index([assigned_to])
  @@index([status])
  @@index([due_date])
}

model ReminderLog {
  id       Int      @id @default(autoincrement())
  actionId Int
  sentAt   DateTime
  method   String
  status   String
}

model Procurement {
  procurement_id Int             @id @default(autoincrement())
  project_id     Int
  wbs_id         Int?
  type           ProcurementType
  description    String
  estimated_cost Float
  actual_cost    Float
  status         String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  contracts      Contract[]
  project        Project         @relation(fields: [project_id], references: [project_id])
  wbs            WBS?            @relation(fields: [wbs_id], references: [wbs_id])
  rfq_responses  RFQResponse[]
}

model Contract {
  contract_id     Int         @id @default(autoincrement())
  procurement_id  Int
  vendor_id       Int
  contract_number String
  name            String
  description     String
  start_date      DateTime
  end_date        DateTime
  value           Float
  status          String
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  procurement     Procurement @relation(fields: [procurement_id], references: [procurement_id])
  vendor          Vendor      @relation(fields: [vendor_id], references: [vendor_id])
}

model Vendor {
  vendor_id          Int           @id @default(autoincrement())
  name               String
  contact_person     String
  contact_info       String
  address            String
  category           String
  performance_rating Float
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  contracts          Contract[]
  rfq_responses      RFQResponse[]
}

model RFQResponse {
  rfq_response_id  Int         @id @default(autoincrement())
  procurement_id   Int
  vendor_id        Int
  quote_amount     Float
  delivery_time    String
  technical_score  Int
  commercial_score Int
  total_score      Int
  status           String      @default("Submitted")
  submitted_date   DateTime    @default(now())
  notes            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  procurement      Procurement @relation(fields: [procurement_id], references: [procurement_id])
  vendor           Vendor      @relation(fields: [vendor_id], references: [vendor_id])
}

model Account {
  account_id          Int                   @id @default(autoincrement())
  user_id             Int                   @unique
  first_name          String
  last_name           String
  department          String
  phone_number        String?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  user                User                  @relation(fields: [user_id], references: [user_id])
  created_baselines   Baseline[]
  uploaded_documents  Document[]
  logged_equipment    EquipmentSiteLog[]
  FieldData           FieldData[]
  submitted_lessons   Lesson[]
  MaintenanceLog      MaintenanceLog[]
  MaintenanceSchedule MaintenanceSchedule[]
  managed_portfolios  Portfolio[]
  created_reports     Report[]
  managed_sites       Site[]
}

model User {
  user_id               Int                 @id @default(autoincrement())
  username              String              @unique
  email                 String              @unique
  password_hash         String
  role_id               Int
  status                String              @default("active")
  idp_user_id           String?             @unique  // MongoDB ObjectId from IdP
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  account               Account?
  processed_approvals   Approval[]          @relation("ProcessedApprovals")
  requested_approvals   Approval[]          @relation("RequestedApprovals")
  targeted_approvals    Approval[]          @relation("TargetedApprovals")
  mentions              CommentMention[]    @relation("UserMentions")
  created_notifications Notification[]      @relation("CreatedNotifications")
  notifications         Notification[]      @relation("UserNotifications")
  created_projects      Project[]           @relation("CreatedProjects")
  managed_projects      Project[]           @relation("ProjectManager")
  projectApprovals      ProjectApproval[]   @relation("User_ProjectApprovals")
  project_assignments   ProjectAssignment[]
  approved_checklists   ProjectChecklist[]  @relation("ChecklistApprover")
  submitted_checklists  ProjectChecklist[]  @relation("ChecklistSubmitter")
  project_teams         ProjectTeamMember[]
  risks                 Risk[]              @relation("RiskOwner")
  assigned_mitigations  RiskMitigation[]    @relation("MitigationAssignee")
  risk_mitigations      RiskMitigation[]    @relation("MitigationOwner")
  created_tasks         Task[]              @relation("CreatedTasks")
  assigned_tasks        TaskAssignment[]    @relation("AssignedTasks")
  comments              TaskComment[]
  time_entries          TimeEntry[]
  approved_timesheets   Timesheet[]         @relation("TimesheetApprover")
  timesheets            Timesheet[]
  role                  Role                @relation(fields: [role_id], references: [role_id])
  completed_closures  ClosureChecklistItem[]
  assigned_punch_items PunchListItem[]
  inspector_inspections FinalInspection[] @relation("InspectorInspections")
  submitted_inspections FinalInspection[] @relation("SubmittedInspections")
  approved_inspections  FinalInspection[] @relation("ApprovedInspections")
  handover_responsible  Handover[]        @relation("HandoverResponsible")
  submitted_handovers   Handover[]        @relation("SubmittedHandovers")
  approved_handovers    Handover[]        @relation("ApprovedHandovers")
  closure_approved_projects Project[]     @relation("ClosureApprovedProjects")
  scheduleApprovals    ScheduleApproval[]
  
  // Project Scheduler Relations
  CreatedSchedules     ProjectSchedule[]      @relation("CreatedSchedules")
  UserSchedules        ScheduleTeamMember[]   @relation("UserSchedules")
  RiskOwnerSchedules   ScheduleRisk[]         @relation("RiskOwnerSchedules")
  MitigationAssigneeSchedules ScheduleRiskMitigation[] @relation("MitigationAssigneeSchedules")
  assigned_schedule_tasks ScheduleTaskAssignment[] @relation("UserAssignedTasks")
  assigned_by_schedule_tasks ScheduleTaskAssignment[] @relation("AssignedBy")
  
  // Recent Activity Relations
  recent_activities    RecentActivity[]
}

model IdpInbox {
  id               Int       @id @default(autoincrement())
  idempotency_key  String    @unique
  event            String
  payload          Json
  status           String    @default("received")
  last_error       String?
  created_at       DateTime  @default(now())
  processed_at     DateTime?

  @@index([idempotency_key])
}

model Role {
  role_id     Int      @id @default(autoincrement())
  name        String   @unique
  description String
  permissions Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       User[]
}

model Report {
  report_id   Int      @id @default(autoincrement())
  name        String
  description String?
  type        String
  template    Json
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  creator     Account  @relation(fields: [created_by], references: [account_id])
}

model Document {
  document_id        Int        @id @default(autoincrement())
  name               String
  description        String?
  file_path          String
  file_type          String
  size               Int
  project_id         Int?
  wbs_id             Int?
  task_id            Int?
  uploaded_by        Int
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  parent_document_id Int?
  version            Int        @default(1)
  parent             Document?  @relation("DocumentVersion", fields: [parent_document_id], references: [document_id])
  children           Document[] @relation("DocumentVersion")
  project            Project?   @relation(fields: [project_id], references: [project_id])
  task               Task?      @relation(fields: [task_id], references: [task_id])
  uploader           Account    @relation(fields: [uploaded_by], references: [account_id])
  wbs                WBS?       @relation(fields: [wbs_id], references: [wbs_id])
  closure_documents  ClosureDocumentItem[]
  handover_receipts  Handover[] @relation("HandoverReceipt")
}

model Lesson {
  lesson_id       Int      @id @default(autoincrement())
  project_id      Int
  title           String
  description     String
  category        String
  impact          String
  recommendations String
  submitted_by    Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  project         Project  @relation(fields: [project_id], references: [project_id])
  submitter       Account  @relation(fields: [submitted_by], references: [account_id])
}

model Baseline {
  baseline_id       Int          @id @default(autoincrement())
  project_id        Int
  name              String
  description       String
  baseline_date     DateTime
  baseline_type     BaselineType
  scope_snapshot    Json
  schedule_snapshot Json
  cost_snapshot     Json
  created_by        Int
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  creator           Account      @relation(fields: [created_by], references: [account_id])
  project           Project      @relation(fields: [project_id], references: [project_id])
}

model EVM {
  evm_id                     Int      @id @default(autoincrement())
  project_id                 Int
  fiscal_period              String
  planned_value              Float
  earned_value               Float
  actual_cost                Float
  cost_performance_index     Float
  schedule_performance_index Float
  estimate_at_completion     Float
  estimate_to_complete       Float
  variance_at_completion     Float
  reporting_date             DateTime
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
  project                    Project  @relation(fields: [project_id], references: [project_id])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  project_id  Int
  amount      Float
  category    String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [project_id], references: [project_id])
}

model Alert {
  id          Int       @id @default(autoincrement())
  project_id  Int
  triggeredAt DateTime
  resolvedAt  DateTime?
  escalated   Boolean   @default(false)
  recipients  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [project_id], references: [project_id])
}

model PerformanceMetric {
  metric_id  Int      @id @default(autoincrement())
  task_id    Int
  cpi        Float
  spi        Float
  status     String
  commentary String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  task       Task     @relation(fields: [task_id], references: [task_id])
}

model Scorecard {
  scorecard_id Int      @id @default(autoincrement())
  task_id      Int
  cpi          Float
  spi          Float
  status       String
  commentary   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  task         Task     @relation(fields: [task_id], references: [task_id])
}

model Escalation {
  escalation_id Int       @id @default(autoincrement())
  task_id       Int
  triggered_at  DateTime
  resolved_at   DateTime?
  escalated_to  String
  reason        String
  status        String    @default("open")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  task          Task      @relation(fields: [task_id], references: [task_id])
}

model Notification {
  notification_id Int                  @id @default(autoincrement())
  user_id         Int
  type            NotificationType
  title           String
  message         String
  priority        NotificationPriority
  metadata        Json?
  status          NotificationStatus   @default(UNREAD)
  read_at         DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  expires_at      DateTime?
  created_by_id   Int
  created_by      User                 @relation("CreatedNotifications", fields: [created_by_id], references: [user_id])
  user            User                 @relation("UserNotifications", fields: [user_id], references: [user_id])

  @@index([created_at])
  @@index([status])
  @@index([user_id])
}

model Approval {
  approval_id    Int            @id @default(autoincrement())
  type           ApprovalType
  status         ApprovalStatus @default(PENDING)
  project_id     Int
  checklist_id   Int?
  requested_by   Int
  target_user_id Int
  approved_by    Int?
  comments       String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  approver       User?          @relation("ProcessedApprovals", fields: [approved_by], references: [user_id])
  requester      User           @relation("RequestedApprovals", fields: [requested_by], references: [user_id])
  target         User           @relation("TargetedApprovals", fields: [target_user_id], references: [user_id])

  @@index([status])
  @@index([project_id])
  @@index([target_user_id])
}

model Site {
  site_id        Int                @id @default(autoincrement())
  site_code      String             @unique
  name           String
  description    String?
  address        String
  project_id     Int
  manager_id     Int
  is_active      Boolean            @default(true)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  equipment_logs EquipmentSiteLog[]
  manager        Account            @relation(fields: [manager_id], references: [account_id])
  project        Project            @relation(fields: [project_id], references: [project_id])
}

model EquipmentSiteLog {
  log_id           Int       @id @default(autoincrement())
  resource_id      Int
  site_id          Int
  logged_in_date   DateTime
  logged_out_date  DateTime?
  usage_hours      Float?
  condition_before String?
  condition_after  String?
  notes            String?
  logged_by        Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  user             Account   @relation(fields: [logged_by], references: [account_id])
  resource         Resource  @relation(fields: [resource_id], references: [resource_id])
  site             Site      @relation(fields: [site_id], references: [site_id])
}

model MaintenanceSchedule {
  schedule_id       Int                 @id @default(autoincrement())
  resource_id       Int
  maintenance_type  MaintenanceType
