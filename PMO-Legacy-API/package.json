{
  "name": "pmo-legacy-api",
  "version": "0.1.0",
  "private": true,
  "description": "The old PMO backend (Next.js API routes + Prisma), kept running until every screen has moved to the new backend.",
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev --turbopack --port 7061",
    "build": "next build",
    "start": "next start --port 7061",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate",
    "cron": "tsx scripts/cron.ts",
    "create-timesheets": "tsx scripts/create-weekly-timesheets.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-minimal.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@prisma/client": "^6.6.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "date-fns": "^3.6.0",
    "jose": "^6.0.10",
    "next": "^15.3.8",
    "node-cron": "^4.1.0",
    "pptxgenjs": "^4.0.0",
    "puppeteer": "^24.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-jsdoc": "^6.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.47",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-jsdoc": "^6.0.4",
    "prisma": "^6.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
