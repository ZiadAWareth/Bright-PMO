# PMO-Client (frontend, port 7060). Copy to .env and fill in.

# Where the legacy API app runs; /api/... is forwarded there (next.config.ts)
LEGACY_API_URL="http://localhost:7061"
# Where the new backend (PMO-Backend, from Soul) runs; /backend/... is forwarded
# there. Leave empty until it is deployed (locally: http://localhost:7062).
BACKEND_URL=

# Verifies the sign-in cookie for pages gated in middleware.ts (/api-docs).
# Must match the legacy API's values.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Sign-in mode: "true" sends sign-in to the IdP instead of the password form
NEXT_PUBLIC_USE_IDP_AUTH="false"
NEXT_PUBLIC_IDP_URL=
NEXT_PUBLIC_IDP_LOGOUT_URL=

# This app's own address, and the API address used outside the browser
NEXT_PUBLIC_APP_URL="http://localhost:7060"
NEXT_PUBLIC_API_URL="http://localhost:7060"

NEXT_PUBLIC_HR_URL=
NEXT_PUBLIC_METABASE_URL=
NEXT_PUBLIC_METABASE_DASHBOARD_ID=
