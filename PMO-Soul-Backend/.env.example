# PMO-Soul-Backend, local development. Copy to .env and fill in.
# Soul's deployed settings go in .env.deployed instead (see README).

# Local PostgreSQL, database pmo_soul (not the legacy database)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pmo_soul"
BACKEND_PORT=7062

# Random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
INTERNAL_API_TOKEN=

CORS_ORIGIN=http://localhost:7060
NODE_ENV=development
PROJECT_ID=pmo-local
APP_NAME=Bright PMO (local)
APP_API_URL=http://localhost:7062
APP_PUBLIC_URL=http://localhost:7062

# In-app notifications need Redis; without it the rest still works
REDIS_URL=redis://localhost:6379
