model Inspection {
  id Int @id @default(autoincrement())
  projectId Int
  kind String
  scheduledAt DateTime
  inspectorId Int?
  status InspectionStatus
  notes String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project? @relation(name: "InspectionToProject_projectIdToid", fields: [projectId], references: [id])
  user User? @relation(name: "InspectionToUser_inspectorIdToid", fields: [inspectorId], references: [id])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, inspectorId])
  @@index([organizationId, status])
  @@index([organizationId, completedAt])
}

