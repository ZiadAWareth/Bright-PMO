model ApprovalPolicy {
  id Int @id @default(autoincrement())
  organizationId Int
  type ApprovalType
  name String
  isActive Boolean
  organization Organization? @relation(name: "ApprovalPolicyToOrganization_organizationIdToid", fields: [organizationId], references: [id])
  approvalpolicysteps ApprovalPolicyStep[] @relation(name: "ApprovalPolicyStepToApprovalPolicy_policyIdToid")

  @@index([organizationId])
  @@index([organizationId, type])
}

model SprintSnapshot {
  id Int @id @default(autoincrement())
  sprintId Int
  date DateTime
  scopePoints Decimal /// @money
  completedPoints Decimal /// @money
  scopeHours Decimal /// @money
  remainingHours Decimal /// @money
  itemCount Int
  doneCount Int
  sprint Sprint? @relation(name: "SprintSnapshotToSprint_sprintIdToid", fields: [sprintId], references: [id])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, sprintId])
  @@index([organizationId, date])
}

model Lesson {
  id Int @id @default(autoincrement())
  projectId Int
  sprintId Int?
  type LessonType
  title String
  description String
  category String?
  impact String?
  recommendations String?
  submittedById Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project? @relation(name: "LessonToProject_projectIdToid", fields: [projectId], references: [id])
  sprint Sprint? @relation(name: "LessonToSprint_sprintIdToid", fields: [sprintId], references: [id])
  user User? @relation(name: "LessonToUser_submittedByIdToid", fields: [submittedById], references: [id])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId])
  @@index([organizationId, sprintId])
  @@index([organizationId, type])
  @@index([organizationId, submittedById])
}

model CommentMention {
  id Int @id @default(autoincrement())
  commentId Int
  userId Int
  comment Comment? @relation(name: "CommentMentionToComment_commentIdToid", fields: [commentId], references: [id])
  user User? @relation(name: "CommentMentionToUser_userIdToid", fields: [userId], references: [id])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, commentId])
  @@index([organizationId, userId])
}

model MaintenanceSchedule {
  id Int @id @default(autoincrement())
  resourceId Int
  type MaintenanceType
  triggerType MaintenanceTrigger
  triggerValue String
  nextDueDate DateTime
  status MaintenanceStatus
  priority Priority
  description String?
  estimatedHours Decimal? /// @money
  estimatedCost Decimal? /// @money
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource Resource? @relation(name: "MaintenanceScheduleToResource_resourceIdToid", fields: [resourceId], references: [id])
  maintenancelogs MaintenanceLog[] @relation(name: "MaintenanceLogToMaintenanceSchedule_scheduleIdToid")
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceId])
  @@index([organizationId, type])
  @@index([organizationId, triggerType])
  @@index([organizationId, nextDueDate])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model ResourceAssignment {
  id Int @id @default(autoincrement())
  resourceId Int
  workItemId Int
  allocationPct Decimal /// @money
  startDate DateTime
  endDate DateTime
  plannedHours Decimal /// @money
  actualHours Decimal /// @money
  plannedQuantity Decimal? /// @money
  progressPct Decimal /// @money
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource Resource? @relation(name: "ResourceAssignmentToResource_resourceIdToid", fields: [resourceId], references: [id])
  workitem WorkItem? @relation(name: "ResourceAssignmentToWorkItem_workItemIdToid", fields: [workItemId], references: [id])
  progressreports ProgressReport[] @relation(name: "ProgressReportToResourceAssignment_resourceAssignmentIdToid")
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceId])
  @@index([organizationId, workItemId])
  @@index([organizationId, startDate])
  @@index([organizationId, endDate])
}

model Eps {
  id Int @id @default(autoincrement())
  organizationId Int
  code String
  name String
  description String?
  level Int
  parentId Int?
