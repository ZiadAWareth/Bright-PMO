// ─── In-App Agent ────────────────────────────────────────────
// Generated by the Soul engine.

/// Single-row provider configuration for this app's assistant.
///
/// NOT tenant-scoped: the key is the app owner's, billed to them, and shared by
/// every organization in the app. Per-tenant keys would need per-tenant billing
/// to mean anything, which this product does not have yet.
model AgentSetting {
  id             Int      @id @default(autoincrement())
  // Always "default". Exists purely so the row can be upserted by a stable
  // unique key instead of by a guessed id.
  scope          String   @unique @default("default")

  provider       String?
  // Not named `model`: that word opens a block in the Prisma grammar, and a
  // field sharing it is a needless bet on parser lookahead.
  modelName      String?
  baseUrl        String?

  // AES-256-GCM ciphertext, never the raw key. Format and key derivation live
  // in src/agent/settings-crypto.ts.
  apiKeyCipher   String?
  // Last four characters of the key in clear, so the UI can show which key is
  // saved without the server ever having to hand the key back.
  apiKeyLast4    String?

  // Lets the generic assistant (the Assistant page) use the provider's own web
  // search. Named agents carry their own switch on the Agent row; this one is
  // app-wide and only honoured on providers that ship a native search.
  assistantWebSearch Boolean @default(false)

  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

/// One answered (or failed) question. The audit trail and the token bill.
model AgentRun {
  id           String         @id @default(cuid())

  // Plain scalars, not a User relation: an audit record has to survive the
  // deletion of the person it refers to.
  userId       Int?
  userEmail    String?

  /// Which surface asked — assistant page, inline panel, workflow pulse.
  /// Present from the start so per-surface cost never needs a backfill.
  surface      String         @default("assistant")

  question     String
  answer       String?
  status       AgentRunStatus @default(RUNNING)
  error        String?

  // Denormalised on purpose. AgentSetting is a single mutable row, so reading
  // history through it would re-attribute every past run to whatever model is
  // configured today.
  provider     String?
  modelName    String?

  /// The Agent row as it stood when this run started — a COPY, not a foreign key.
  ///
  /// Agents are edited in place. Pointing at the live row would mean that widening an agent's
  /// allowedEntities today silently rewrites what last month's audit says it was permitted to
  /// read, which is the one thing an audit trail must never do. Null for runs from the assistant
  /// page, which has no Agent row behind it.
  ///
  /// A snapshot column rather than an AgentVersion table on purpose (decision D6): versioning
  /// buys history nobody asked to browse, and costs a join on every read of the audit log.
  definitionSnapshot Json?
  /// Which agent ran. A plain scalar with NO relation, like userId above: the run is a billing
  /// record and must outlive the agent being deleted. Indexed because "what has this agent cost
  /// us" is the question the spend page exists to answer, and digging it out of the snapshot
  /// JSON would mean a table scan.
  agentId      String?

  iterations   Int            @default(0)
  /// True when the iteration cap was hit before the model produced an answer —
  /// the signal that a question was too hard, distinct from an outright failure.
  stoppedEarly Boolean        @default(false)

  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)

  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  durationMs   Int?

  steps        AgentRunStep[]

  @@index([userId])
  @@index([startedAt])
  @@index([status])
  @@index([agentId])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

/// One tool call inside a run, in the order it happened.
model AgentRunStep {
  id         String   @id @default(cuid())
  runId      String
  /// Position in the run, from 1. Ordering by createdAt is unsafe: several calls
  /// in one iteration can land inside the same millisecond.
  seq        Int
  toolName   String
  args       Json?
  ok         Boolean  @default(true)
  /// The tool's one-line summary, or its error when it failed.
  summary    String?
  durationMs Int?
  createdAt  DateTime @default(now())

  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One thread of questions and answers with the assistant.
model AgentConversation {
  id        String   @id @default(cuid())

  // Plain scalars for the same reason as AgentRun: the thread is content, and content
  // should not disappear the instant an account is removed.
  userId    Int?
  userEmail String?

  /// Which surface started the thread.
  surface   String   @default("assistant")
  /// Taken from the first question, truncated. Naming a thread is not worth a model call.
  title     String?

  createdAt DateTime @default(now())
  /// Bumped on every turn. This, not createdAt, is what a "recent conversations" list orders by.
  updatedAt DateTime @updatedAt

  messages  AgentMessage[]

  @@index([userId, updatedAt])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

/// One turn. Either the person's question or the assistant's answer — never a tool call.
model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// Position in the thread, from 1. Two turns can share a millisecond, so createdAt
  /// cannot be trusted to order them.
  seq            Int
  /// "user" or "assistant". Not an enum: the wire formats already disagree about role
  /// names, and a Prisma enum would have to be migrated to admit a third one.
  role           String
  content        String

  /// The AgentRun that produced this answer, for "show me how you worked that out".
  /// A plain scalar with NO relation, deliberately: a run is an audit and billing record
  /// and must outlive the thread, so deleting a conversation must not cascade into it.
  runId          String?

  /// What the answer was read from, e.g. "Ticket (7 rows) · User (2 rows)". Folded from what
  /// the TOOLS reported, never from the answer text — a model asked to cite itself will
  /// eventually cite a record it never read, and a confident wrong citation is worse than none.
  ///
  /// A String rather than Json: it is a finished display line with exactly one rendering, and a
  /// Json column would invite callers to re-format it differently on each surface, which is how
  /// the same answer starts claiming two different sets of sources. Null on a user turn, and on
  /// answers from before this existed.
  sources        String?

  createdAt      DateTime @default(now())

  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

/// One configured agent: a job description plus the limits it works inside.
model Agent {
  id              String   @id @default(cuid())

  name            String
  /// One line, shown in pickers and used by orchestrators to choose between agents.
  role            String?
  /// The agent's own system instructions, appended to the runtime's grounding prompt.
  instructions    String

  /// Entity names this agent may read. Empty means none. Never widens the caller's permissions.
  allowedEntities String[]
  /// Tool names this agent may call. Empty means none, for the same reason.
  allowedTools    String[]
  /// May this agent search the web? Uses the provider's own search on the app's key; off by
  /// default because an enterprise agent's whole value is that it answers from THIS app's data.
  webSearch       Boolean  @default(false)

  /// Overrides AgentSetting.modelName for this agent only. Null means use the app default.
  modelOverride   String?
  /// Null means use the runtime default rather than zero: a stored 0 would be a silent
  /// "never call a tool", which is not a configuration anybody would choose on purpose.
  maxIterations   Int?
  /// JSON Schema the answer must match, so a gateway can branch on a typed field instead of
  /// on free prose.
  outputSchema    Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  /// Tenant discriminator (PG-11) — filtered by the Prisma layer.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

/// How this app sends email. One row, written by an administrator.
///
/// The password is AES-256-GCM ciphertext (src/agent/settings-crypto.ts, the same helper the AI
/// provider key uses) and never leaves the server; `passwordLast4` exists so the UI can show
/// WHICH password is saved without the server handing it back.
model MailSetting {
  id             Int      @id @default(autoincrement())
  // Always "default". Exists so the row can be upserted by a stable unique key.
  scope          String   @unique @default("default")

  host           String?
  port           Int?
  secure         Boolean  @default(false)
  username       String?
  passwordCipher String?
  passwordLast4  String?
  // The envelope sender. Split into address and display name so the UI can ask for them
  // separately instead of teaching an admin the "Name <addr>" syntax.
  fromAddress    String?
  fromName       String?

  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

/// How people sign in to this app. One row, written by an administrator.
///
/// `methods` is a comma-separated list drawn from "password" and "otp" — stored as text rather
/// than as an enum because an enum would need a migration to add a third method, and the parser
/// (src/auth/auth-methods.ts) already refuses anything it does not recognise.
model AuthSetting {
  id             Int      @id @default(autoincrement())
  scope          String   @unique @default("default")

  methods        String   @default("password")

  // Public sign-up: off until an administrator turns it on. The role and organisation a new
  // account gets are chosen HERE, never by the person signing up. The role is stored by NAME,
  // as the roles page shows it, and checked again on every sign-up (it may have been widened since).
  signUpEnabled        Boolean @default(false)
  signUpRole           String?
  signUpOrganizationId Int?

  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

/// The single-use link an invited person follows to set their own password.
///
/// STORED HASHED (SHA-256 of the token). A leaked dump of this table is then a list of digests,
/// not a set of working links. SHA-256 and not bcrypt on purpose: the token is 32 random bytes
/// from the CSPRNG, so there is no low-entropy secret to stretch, and a digest can carry a UNIQUE
/// index — which is what makes "find the row for this link" one indexed lookup instead of a scan
/// over every outstanding invite comparing bcrypt hashes.
///
/// `userId` is a plain scalar with NO relation, so this appender never has to stamp a
/// back-relation field onto the customer's own user model.
model AuthSetupToken {
  id        String    @id @default(cuid())
  userId    Int
  // Denormalised so the email a link was sent to is knowable even after the address is changed.
  email     String
  tokenHash String    @unique
  // 'invite' (an administrator created the account) or 'reset' (the owner forgot the password).
  // One table, one hashing and single-use rule; the purpose only changes the wording, the lifetime
  // and what happens after the password is set.
  purpose   String    @default("invite")
  expiresAt DateTime
  // Set the moment the token is spent. A used token is kept, not deleted, so a second click can
  // be answered with "this link has already been used" instead of "no such link".
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A one-time sign-in code sent by email.
///
/// Hashed for the same reason as the setup token, and bound to the address it was issued for: the
/// digest covers "email:code", so a code harvested for one mailbox cannot be replayed against
/// another. `attempts` is what makes a 6-digit code safe — the row locks itself long before
/// a million guesses are possible.
model AuthLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// "Sign this person out everywhere": access tokens issued before `revokedBefore` stop working.
///
/// Sessions are stateless JWTs, so ending them needs a record of WHEN they stopped being trusted.
/// Written when a password is reset; read once at startup into memory (src/auth/session-revocations
/// .ts), so AuthGuard checks it without a database query per request. One row per user, overwritten.
/// `userId` is a plain scalar with no relation, like AuthSetupToken's.
model AuthSessionRevocation {
  userId        Int      @id
  revokedBefore DateTime
  updatedAt     DateTime @updatedAt
}

/// A UI Builder's connection to this app: a long-lived, READ-ONLY credential that can do exactly one
/// thing — be exchanged (POST /api/frontend-design/builder-token) for a 10-minute token that only the
/// app-contract route accepts. It acts as the person who connected, with their CURRENT role, so a
/// role change or a removed user takes effect at once; revoking the row ends the connection.
///
/// Stored HASHED (SHA-256), like the setup token: a leaked dump is a list of digests, not keys.
model BuilderKey {
  id         String    @id @default(cuid())
  userId     Int
  // The person's sign-in address when the key was issued; the exchange signs THIS person in.
  email      String
  keyHash    String    @unique
  label      String    @default("UI Builder")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// ─── Dynamic Dashboards (Dashboard Engine) ──────────────────
// Generated by the Soul engine.

/// This app's connection to the Dashboard Engine. One row, written by the app owner.
model DashboardEngineConnection {
  id                    Int       @id @default(autoincrement())
  scope                 String    @unique @default("default")
  /// disconnected | pending | connected | revoked
  status                String    @default("disconnected")
  /// The engine's web address (approval page, embed pages) and its API address.
  engineUrl             String?
  engineApiUrl          String?
  /// The engine's name for this app, and the ID of the key it verifies this app with.
  clientId              String?
  keyId                 String?
  /// AES-256-GCM ciphertext of the app's ES256 private key. Never leaves the server.
  privateKeyCipher      String?
  pendingState          String?
  pendingVerifierCipher String?
  pendingRedirectUri    String?
  pendingStartedAt      DateTime?
  workspaceName         String?
  workspaceCreated      Boolean   @default(false)
  sharedProjectName     String?
  /// self_service | owner_only | automatic
  orgPolicy             String    @default("self_service")
  lockOrgOptOut         Boolean   @default(false)
  connectedAt           DateTime?
  connectedByEmail      String?
  lastError             String?
  updatedAt             DateTime  @updatedAt
  updatedByEmail        String?
}

/// Whether an organization uses Dynamic Dashboards. One row per organization that has decided.
model DashboardEngineOrg {
  id               Int       @id @default(autoincrement())
  orgId            Int       @unique
  /// active | inactive | requested
  status           String    @default("inactive")
  changedByEmail   String?
  changedAt        DateTime?
  requestedByEmail String?
  updatedAt        DateTime  @updatedAt
}

/// A Dashboard Engine dashboard in this app's Dynamic Dashboards list.
model EmbeddedDashboard {
  id           Int      @id @default(autoincrement())
  /// dashboard | widget
  kind         String   @default("dashboard")
  engineId     String
  engineOrigin String
  /// The organization it is shown to; null = every organization (added by the app owner).
  orgId        Int?
  title        String
  description  String?
  /// Display options read from the pasted code (theme, hidden title/filters, refresh, height).
  options      Json?
  /// AES-256-GCM ciphertext of the engine embed token pasted with the code, if any.
  tokenCipher  String?
  sortOrder    Int      @default(0)
  addedByEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
}
